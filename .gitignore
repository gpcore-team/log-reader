# ─── Приватные профили ─────────────────────────────────────────────
# Публичный пример: profiles/example.toml (включён в репозиторий).
# Реальные профили с сайтами и IP-адресами НЕ коммитим.
profiles/*.toml
!profiles/example.toml

# ─── Runtime-данные ────────────────────────────────────────────────
# Логи, состояние, кеши, архивы. Живут только на хостах, не в git.
log/
state/
backup/
*.log
*.mmdb
*.mmdb.gz

# ─── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# ─── Система ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*~
